## Environment variables for the Weekly Report Agent - copy to .env and
## fill in real values. Never commit the real .env (already gitignored).

# Databricks Workspace URL (e.g., https://dbc-xxxxxxxx-xxxx.cloud.databricks.com)
DATABRICKS_HOST=
# Databricks Personal Access Token (DAPI key)
DATABRICKS_TOKEN=

MODEL_NAME=databricks-llama-4-maverick

# Azure AD Credentials (Microsoft Graph - mail send)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SYSTEM_SENDER_EMAIL=

# PostgreSQL connection string. Percent-encode special characters in the
# password (e.g. "@" -> "%40").
DATABASE_URL=postgresql://user:password@host:5432/dbname
